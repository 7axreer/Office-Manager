# Server porti
PORT=3000
# Ma'lumotlar papkasi (db.json shu yerda saqlanadi)
DATA_DIR=./data
# Ixtiyoriy: administrator parolini majburan o'rnatish/tiklash
# ADMIN_PASSWORD=kuchli-parol
# HTTPS orqasida ishlasa (nginx, Caddy) cookie Secure bo'lsin
# COOKIE_SECURE=1
# Ixtiyoriy: o'z Telegram Bot API serveringiz
# TELEGRAM_API_URL=https://api.telegram.org
